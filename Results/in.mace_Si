                                                       in.mace_Si
# MACE Silicon MD simulation
units metal
atom_style atomic
atom_modify   map yes
newton on

# Silicon structure
lattice diamond 5.43
region box block 0 3 0 3 0 3
create_box 1 box
create_atoms 1 box

mass 1 28.0855

# MACE potential
pair_style mace no_domain_decomposition
pair_coeff * * mace_Si.model-lammps.pt Si

# Settings
timestep 0.001
thermo 100

# Energy minimization
minimize 1.0e-4 1.0e-6 100 1000

# MD run at 300K
velocity all create 300.0 12345
fix 1 all nvt temp 300 300 0.1
run 1000

write_dump all atom dump.atom
